{
  "name": "datalens-local",
  "version": "0.1.0",
  "description": "Desktop app built with Electron, Next.js, React, and Tailwind CSS",
  "author": "DataLens",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on tcp:3000 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "build:next": "next build",
    "build:electron": "cross-env NODE_ENV=production electron-builder",
    "build": "npm run build:next && npm run build:electron",
    "package": "npm run build:next && cross-env NODE_ENV=production electron-builder --dir",
    "preview": "npm run build:next && cross-env NODE_ENV=production electron .",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.datalens.local",
    "productName": "DataLens Local",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "electron-serve": "^1.3.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
